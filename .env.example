# Copy to .env.local. NEXT_PUBLIC_ values are inlined into the browser bundle
# at build time, so never put secrets here and rebuild after changing them.

# Base URL of the backend API (no trailing slash). Required for production builds.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Upload URLs come from backend responses. Set the backend PUBLIC_API_URL to
# its browser-accessible origin (HTTPS in production), and allow this frontend
# origin in backend CORS_ORIGINS. No upload directory belongs in the frontend.
